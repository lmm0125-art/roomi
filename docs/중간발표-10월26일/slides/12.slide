      <Box style={{ width:386, background:'#FFFFFF', border:'1px solid #E3EAF2', borderRadius:14, padding:'20px 22px' }}>
        <Text style={{ fontSize:23, fontWeight:'bold', color:'#0F6E56' }}>공작소</Text>
        <Text style={{ fontSize:17, color:'#33475B', marginTop:10 }}>커스터마이징 + AI 모듈</Text>
        <Text style={{ fontSize:14, color:'#64748B', marginTop:8 }}>AI 프롬프트·생성 로직</Text>
