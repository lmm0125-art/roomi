  <Box style={{ width:'100%', height:'1px', background:'#E3EAF2' }} />

  <Box style={{ width:'100%', height:'456px', marginTop:'18px', flexDirection:'column' }}>

    <Box style={{ width:'100%', flexDirection:'row', gap:16 }}>
      <Box style={{ width:386, background:'#FFFFFF', border:'1px solid #E3EAF2', borderRadius:14, padding:'20px 22px' }}>
