        <Text style={{ fontSize:17, color:'#33475B', marginTop:10 }}>획득 6곳 · 소비 5곳</Text>
        <Text style={{ fontSize:14, color:'#64748B', marginTop:8 }}>서버 지급 로직 + 상점 아이템</Text>
